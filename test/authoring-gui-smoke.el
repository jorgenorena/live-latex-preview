(require 'live-tex-preview-authoring)
(require 'live-tex-preview-test)
(require 'markdown-mode)
(require 'quarto-mode)
(require 'reftex)

(defun live-tex-preview-authoring-test-gui ()
  "Check real images, explicit producers and references in all frontends."
  (let ((directory (make-temp-file "live-tex-authoring-gui-" t))
        results failure buffers phase)
    (unwind-protect
        (condition-case err
            (dolist (mode '(latex-mode markdown-mode poly-quarto-mode))
              (let* ((tex (eq mode 'latex-mode))
                     (dir (file-name-as-directory
                           (expand-file-name (symbol-name mode) directory)))
                     (default-directory dir)
                     (file (expand-file-name (if tex "main.tex" "main.qmd") dir))
                     (host (generate-new-buffer (file-name-nondirectory file))))
                (make-directory dir t)
                (push host buffers)
                (with-temp-file (expand-file-name "plot.svg" dir)
                  (insert "<svg xmlns='http://www.w3.org/2000/svg' width='160' height='90'><rect width='160' height='90' fill='#008080'/></svg>"))
                (with-temp-file (expand-file-name "refs.bib" dir)
                  (insert "@article{smith2024, title={An example}, author={Smith}, year={2024}}\n"))
                (with-current-buffer host
                  (switch-to-buffer host)
                  (setq buffer-file-name file default-directory dir)
                  (insert
                   (if tex
                       "\\documentclass{article}\n\\begin{document}\nSee \\eqref{eq:energy}.\n\\begin{equation} E=mc^2 \\label{eq:energy} \\end{equation}\n\\begin{figure}\n% !run = printf produced > produced.txt\n\\includegraphics{plot.svg}\n\\end{figure}\n\\end{document}\n"
                     "---\nbibliography: refs.bib\n---\n\nSee @eq-energy. Citation [@smith2024].\n\n$$ E=mc^2 $$ {#eq-energy}\n\n<!-- !run = printf produced > produced.txt -->\n![Plot](plot.svg)\n\n```{python}\ntext = '![not an image](plot.svg)'\n```\n"))
                  (funcall mode)
                  (save-buffer)
                  (unless (display-graphic-p) (error "A graphical frame is required"))
                  (setq phase (list mode 'images))
                  (with-temp-file "/tmp/live-tex-preview-authoring-gui-progress.el" (prin1 phase (current-buffer)))
                  (unless (= 1 (live-tex-preview-authoring-preview-images-buffer))
                    (error "Wrong image count in %s" mode))
                  (let* ((ov (cl-find-if
                              (lambda (ov) (overlay-get ov 'live-tex-preview-authoring-image))
                              (overlays-in (point-min) (point-max))))
                         (size (image-size (overlay-get ov 'display) t)))
                    (unless (and (> (car size) 0) (> (cdr size) 0))
                      (error "Invalid authoring image in %s" mode)))
                  (setq phase (list mode 'producer))
                  (with-temp-file "/tmp/live-tex-preview-authoring-gui-progress.el" (prin1 phase (current-buffer)))
                  (goto-char (point-min)) (search-forward "!run")
                  (let ((compilation-ask-about-save nil)
                        (compilation-read-command nil)
                        (deadline (+ (float-time) 8)))
                    (live-tex-preview-authoring-dwim-at-point)
                    (while (and (not (file-exists-p (expand-file-name "produced.txt" dir)))
                                (< (float-time) deadline))
                      (accept-process-output nil 0.05))
                    (unless (file-exists-p (expand-file-name "produced.txt" dir))
                      (error "Figure producer did not run in %s" mode)))
                  (setq phase (list mode 'reference))
                  (with-temp-file "/tmp/live-tex-preview-authoring-gui-progress.el" (prin1 phase (current-buffer)))
                  (switch-to-buffer host)
                  (goto-char (point-min)) (search-forward (if tex "eq:energy" "@eq-energy"))
                  (backward-char 3)
                  (when tex (reftex-mode 1))
                  (live-tex-preview-authoring-follow-reference-at-point)
                  (switch-to-buffer host)
                  (setq phase (list mode 'citation))
                  (with-temp-file "/tmp/live-tex-preview-authoring-gui-progress.el" (prin1 phase (current-buffer)))
                  (unless tex
                    (goto-char (point-min)) (search-forward "@smith2024") (backward-char 3)
                    (live-tex-preview-authoring-follow-reference-at-point)
                    (unless (string-suffix-p "refs.bib" (buffer-file-name (window-buffer (selected-window))))
                      (error "Citation destination was wrong in %s" mode))
                    (switch-to-buffer host))
                  (setq phase (list mode 'code))
                  (with-temp-file "/tmp/live-tex-preview-authoring-gui-progress.el" (prin1 phase (current-buffer)))
                  (when (eq mode 'poly-quarto-mode)
                    (goto-char (point-min)) (search-forward "text =")
                    (pm-switch-to-buffer)
                    (setq phase (list mode 'code-switched))
                    (with-temp-file "/tmp/live-tex-preview-authoring-gui-progress.el" (prin1 phase (current-buffer)))
                    (when (cl-find-if
                           (lambda (ov) (overlay-get ov 'live-tex-preview-authoring-image))
                           (overlays-in (point-min) (point-max)))
                      (error "Image overlay moved into executable code"))
                    (switch-to-buffer host))
                  (setq phase (list mode 'clear))
                  (with-temp-file "/tmp/live-tex-preview-authoring-gui-progress.el" (prin1 phase (current-buffer)))
                  (live-tex-preview-authoring-clear-image-previews)
                  (push mode results))))
          (error (setq failure (error-message-string err))))
      (setq phase 'cleanup)
      (with-temp-file "/tmp/live-tex-preview-authoring-gui-progress.el" (prin1 phase (current-buffer)))
      (dolist (buffer (buffer-list))
        (when (and (buffer-live-p buffer)
                   (or (memq buffer buffers)
                       (with-current-buffer buffer
                         (and buffer-file-name (string-prefix-p directory buffer-file-name)))))
          (with-current-buffer buffer (set-buffer-modified-p nil))
          (let ((kill-buffer-query-functions nil)) (kill-buffer buffer))))
      (delete-directory directory t))
    (with-temp-file "/tmp/live-tex-preview-authoring-gui-result.el"
      (prin1 (list :success (not failure) :error failure :phase phase :frontends (nreverse results)
                   :checks '(real-images explicit-producers references citations code-exclusion))
             (current-buffer)))
    (kill-emacs (if failure 1 0))))

(run-at-time 1 nil #'live-tex-preview-authoring-test-gui)
